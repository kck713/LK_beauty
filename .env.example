# 출시 전 실제 값으로 설정합니다. (도메인은 가용성·이력 확인 후 확정)
SITE_URL=https://www.example.com
# 폼 접수 엔드포인트 (docs/FORM_API.md 참고). 비어 있으면 폼은 접수 불가 상태로 안내합니다.
FORM_ENDPOINT=
# Google Tag Manager 컨테이너 ID (선택). 비어 있으면 dataLayer만 기록합니다.
GTM_ID=
# PREVIEW=1 이면 verified:false 항목을 '미확정' 배지와 함께 렌더링합니다. 공개 배포에서는 설정하지 않습니다.
PREVIEW=
